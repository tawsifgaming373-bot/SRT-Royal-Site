# Environment Configuration Example
# এই file টা copy করে .env নামে save করো
# .env কখনো GitHub এ push করবে না!

# Server Port
PORT=5000

# JWT Secret — production এ অবশ্যই random string ব্যবহার করবে
JWT_SECRET=your_strong_random_secret_here

# Node Environment
NODE_ENV=development

# ── Optional: Email (এখন use হচ্ছে না, ভবিষ্যতের জন্য) ──
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# ✅ FIXED: Real email/password এখানে দেওয়া হয়নি
# EMAIL_USER=your_email@example.com
# EMAIL_PASSWORD=your_email_password
