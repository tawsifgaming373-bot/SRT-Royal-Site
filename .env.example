PORT=3000
NODE_ENV=development
# Never put real credentials in this file. Copy it to .env and fill in real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/srt-royal?appName=Cluster0
JWT_SECRET=replace_with_a_strong_random_secret_of_32_chars_or_more
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Optional: Google sign-in. Create an OAuth client ID at console.cloud.google.com
# and register the callback URL: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub sign-in. Create an OAuth App at github.com/settings/developers
# and register the callback URL: https://YOUR-DOMAIN/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: password reset emails via Resend (https://resend.com, free tier).
# EMAIL_FROM looks like: "SRT Royal <noreply@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# Optional: where hire-request and contact-form notifications are sent.
# If unset, submissions are still saved to the database (admin can read them).
OWNER_EMAIL=

# Test-only default is MongoDB 4.2.25 for older CPUs. Do not use this for production.
# MONGOMS_VERSION=4.2.25

# Optional production storage provider. Image uploads require a configured provider.
STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email provider configuration.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional payment provider configuration. Keep gateway callbacks server-side.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
